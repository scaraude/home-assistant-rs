# Ignore build artifacts
target/
# Exception: Include the ARM64 binary for deployment
!target/aarch64-unknown-linux-musl/
target/aarch64-unknown-linux-musl/*
!target/aarch64-unknown-linux-musl/release/
target/aarch64-unknown-linux-musl/release/*
!target/aarch64-unknown-linux-musl/release/home-assistant-rs
*.db
*.db-shm
*.db-wal

# Ignore Git
.git/
.gitignore

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore documentation
README.md
*.md

# Ignore deployment files
deploy.sh
docker-compose.yml

# Ignore data directory
data/
