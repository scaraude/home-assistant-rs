# Deployment Configuration for Raspberry Pi
# Copy this file to .env.deploy and customize for your setup

# Raspberry Pi Connection Settings
PI_USER=pi
PI_HOST=raspberrypi.local
# Or use IP address:
# PI_IP=192.168.1.100

# SSH Key (default is usually fine)
SSH_KEY=~/.ssh/id_rsa

# Deployment Directories on Raspberry Pi
DEPLOY_DIR=/opt/home-automation-rs
DATA_DIR=/var/lib/home-automation-rs
LOG_DIR=/var/log/home-automation-rs

# Zigbee USB Device
# Common values:
# - /dev/ttyUSB0 (most USB Zigbee adapters)
# - /dev/ttyACM0 (some adapters)
# - /dev/serial/by-id/usb-... (persistent naming)
ZIGBEE_DEVICE=/dev/ttyUSB0

# Zigbee2MQTT network settings (must match coordinator)
# Z2M_PAN_ID=GENERATE
# Z2M_EXT_PAN_ID=GENERATE
# Z2M_NETWORK_KEY=GENERATE
# Z2M_CHANNEL=11

# Discord webhook for device availability alerts (optional).
# Create one via Discord > Channel settings > Integrations > Webhooks.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Rust Cross-Compilation Target
# Default (musl) builds natively on macOS with no Docker — see `make setup-cross-compile`.
# - aarch64-unknown-linux-musl     (Pi Zero 2 W / any 64-bit Pi) - RECOMMENDED, static, no Docker
# - aarch64-unknown-linux-gnu      (Pi 3/4/Zero 2 with 64-bit OS) - needs cross/Docker on macOS
# - armv7-unknown-linux-gnueabihf  (Pi 3/4 with 32-bit OS)
RUST_TARGET=aarch64-unknown-linux-musl
