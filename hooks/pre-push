#!/bin/bash
set -e

echo "🦀 Building ARM64 binary for Raspberry Pi deployment..."

# Build for ARM64
if ! cargo build --release --target aarch64-unknown-linux-musl; then
    echo "❌ Build failed! Push aborted."
    exit 1
fi

BINARY_PATH="target/aarch64-unknown-linux-musl/release/home-assistant-rs"

if [ ! -f "$BINARY_PATH" ]; then
    echo "❌ Binary not found at $BINARY_PATH! Push aborted."
    exit 1
fi

echo "✅ ARM64 binary built successfully!"
echo "📊 Binary size: $(du -h $BINARY_PATH | cut -f1)"
echo ""
